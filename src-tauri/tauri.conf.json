{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wikexp",
  "version": "0.1.0",
  "identifier": "dev.wiktor.pulpit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WikExp",
        "width": 1400,
        "height": 900,
        "decorations": false,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true
      },
      {
        "label": "bar",
        "title": "WikExp pasek",
        "width": 40,
        "height": 800,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false,
        "maximizable": false,
        "minimizable": false
      },
      {
        "label": "launcher",
        "title": "WikExp szukaj",
        "width": 340,
        "height": 376,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
