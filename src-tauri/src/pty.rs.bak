use portable_pty::{native_pty_system, CommandBuilder, PtySize};
use std::io::Read;
use std::thread;

#[tauri::command]
pub fn pty_spawn() -> Result<(), String> {
    println!("pty_spawn: start");
    // TODO 1: Otwórz pseudo-terminal.
    //   native_pty_system() zwraca „system PTY” (na Windowsie ConPTY).
    //   Na nim .openpty(PtySize { rows: 24, cols: 80, pixel_width: 0, pixel_height: 0 })
    //   Zwraca Result, więc na końcu .map_err(|e| e.to_string())?
    //   Wynik zapisz w zmiennej `pair`. Ma dwa pola: pair.master i pair.slave.
    //   master = twoja strona (czytasz/piszesz), slave = strona shella.
        let pair = native_pty_system()
            .openpty(PtySize { rows: 24, cols: 80, pixel_width: 0, pixel_height: 0 })
            .map_err(|e| e.to_string())?;
    // TODO 2: Uruchom PowerShella po stronie slave.
    //   CommandBuilder::new("powershell.exe") opisuje, co odpalić.
    //   pair.slave.spawn_command(...) faktycznie uruchamia proces.
    //   Też Result, więc map_err + ?. Wynik do zmiennej `_child`
    //   (podkreślnik = „wiem, że na razie nie używam”, bez ostrzeżenia).

    let cmd = CommandBuilder::new("powershell.exe");
    let _child = pair.slave.spawn_command(cmd).map_err(|e| e.to_string())?;



    // TODO 3: Weź reader z mastera.
    //   pair.master.try_clone_reader(), znowu map_err + ?.
    //   To strumień wszystkiego, co shell wypisuje.
    
    let mut reader = pair.master.try_clone_reader().map_err(|e| e.to_string())?;


    // TODO 4: Uruchom wątek, który czyta w pętli.
    //   thread::spawn(move || { ... });
    //   `move` przenosi reader (i master, patrz uwaga niżej) do wątku.
    //   W środku:
    //     - bufor: let mut buf = [0u8; 4096];  (4096 bajtów zer)
    //     - loop { match reader.read(&mut buf) { ... } }
    //       Ok(0)  → shell się zamknął, break
    //       Ok(n)  → przeczytano n bajtów: wypisz &buf[..n]
    //                przez println!("{}", String::from_utf8_lossy(&buf[..n]));
    //       Err(_) → break

    

    thread::spawn(move || { 
        let _master = pair.master;
        let mut buf = [0u8; 4096];

        loop {
            println!("pty: wątek start");
            match reader.read(&mut buf) {
                Ok(0) => { println!("pty: EOF, shell zamknięty"); break; }
                Ok(n) => { println!("pty: {n} bajtów: {:?}", String::from_utf8_lossy(&buf[..n])); }
                Err(e) => { println!("pty: błąd odczytu: {e}"); break; }

            }
    };
    println!("pty: wątek koniec");
    });
// TODO 5: Zwróć sukces: Ok(())
    Ok(())
}
