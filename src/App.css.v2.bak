:root {
  --crust: #11111b; --mantle: #181825; --base: #1e1e2e;
  --surface: #313244; --overlay: #45475a;
  --text: #cdd6f4; --muted: #6c7086;
  --accent: #cba6f7; --blue: #89b4fa; --green: #a6e3a1;
  --yellow: #f9e2af; --red: #f38ba8;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body, #root { height: 100%; }
body {
  background: var(--crust); color: var(--text);
  font-family: "JetBrains Mono", "Cascadia Mono", Consolas, monospace;
  font-size: 13px; overflow: hidden; user-select: none;
}
.shell {
  height: 100vh; display: grid; gap: 8px; padding: 12px;
  grid-template-columns: 260px 1fr 320px;
  grid-template-rows: 1fr 240px auto;
  grid-template-areas:
    "tree main side"
    "tree term docker"
    "status status status";
}
.panel {
  background: var(--base); border: 1px solid var(--overlay);
  border-radius: 6px; display: flex; flex-direction: column;
  min-height: 0; overflow: hidden;
}
.panel.active { border-color: var(--accent); }
.panel-title { color: var(--accent); padding: 8px 12px 4px; }
.panel-body { padding: 4px 12px 12px; overflow: auto; flex: 1; min-height: 0; }
.row { display: flex; padding: 1px 4px; white-space: pre; }
.row.sel { background: var(--surface); }
.row.head { color: var(--muted); border-bottom: 1px solid var(--overlay); margin-bottom: 4px; }
.c-name { flex: 1; } .c-type { width: 80px; }
.muted { color: var(--muted); } .accent { color: var(--accent); } .green { color: var(--green); }
.status { grid-area: status; display: flex; gap: 12px; align-items: center; color: var(--muted); }
.status .spacer { flex: 1; }
.mode { background: var(--accent); color: var(--crust); padding: 1px 8px; }
.red { color: var(--red); }
/* cały pasek */
::-webkit-scrollbar {
  width: 6px;        /* pionowy */
  height: 6px;       /* poziomy */
}

/* tor, po którym jeździ suwak */
::-webkit-scrollbar-track {
  background: transparent;
}

/* sam suwak */
::-webkit-scrollbar-thumb {
  background: var(--overlay);
  border-radius: 4px;
}

/* po najechaniu myszką */
::-webkit-scrollbar-thumb:hover {
  background: var(--accent);
}

/* róg, gdzie stykają się pionowy i poziomy */
::-webkit-scrollbar-corner {
  background: transparent;
}
.panel-body:has(> .term-container) { overflow: hidden; padding: 4px 8px 8px; }
.term-container {
  width: 100%;
  height: 100%;
}

.yellow { color: var(--yellow); }
.c-num { width: 6ch; text-align: right; }
.c-mem { width: 10ch; text-align: right; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.c-status { max-width: 14ch; text-align: right; }
