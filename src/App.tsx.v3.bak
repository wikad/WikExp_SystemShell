import { homeDir } from "@tauri-apps/api/path";
import { getCurrentWindow } from "@tauri-apps/api/window";
import { readDir, formatSize, type FileEntry, parentDir } from "./api";
import { useCallback, useEffect, useRef, useState, useReducer, type ReactNode } from "react";
import "./App.css";
import { TerminalPanel } from "./TerminalPanel";
import { TreePanel } from "./TreePanel";
import { ProcessesPanel } from "./ProcessesPanel";
import { DockerPanel } from "./DockerPanel";
import { Workspace } from "./Workspace";
import { loadLayout, saveLayout, type PanelId, type PanelKind, type Rect } from "./layout";






type Nav = { back: string[]; cwd: string | null; forward: string[] };
type NavAction =
  | { type: "init"; path: string }
  | { type: "go"; path: string }
  | { type: "back" }
  | { type: "forward" };

function navReducer(s: Nav, a: NavAction): Nav {
  switch (a.type) {
    case "init":
      return { back: [], cwd: a.path, forward: [] };
    case "go":
      if (!s.cwd || a.path === s.cwd) return { ...s, cwd: a.path };
      return { back: [...s.back, s.cwd].slice(-50), cwd: a.path, forward: [] };
    case "back":
      if (!s.cwd || s.back.length === 0) return s;
      return {
        back: s.back.slice(0, -1),
        cwd: s.back[s.back.length - 1],
        forward: [...s.forward, s.cwd],
      };
    case "forward":
      if (!s.cwd || s.forward.length === 0) return s;
      return {
        back: [...s.back, s.cwd],
        cwd: s.forward[s.forward.length - 1],
        forward: s.forward.slice(0, -1),
      };
  }
}



type Dir = "h" | "j" | "k" | "l";
const DIR_BY_CODE: Record<string, Dir> = { KeyH: "h", KeyJ: "j", KeyK: "k", KeyL: "l" };

// Nawigacja przestrzenna: szuka panelu w danym kierunku na podstawie
// faktycznych pozycji na ekranie, więc działa przy każdym układzie grida.
function findNeighbor(from: PanelId, dir: Dir, recent: PanelId[]): PanelId | null {
  const rectOf = (id: string) =>
    document.querySelector(`[data-panel="${id}"]`)?.getBoundingClientRect();
  const a = rectOf(from);
  if (!a) return null;

  let best: { id: PanelId; dist: number; rank: number } | null = null;
  for (const el of document.querySelectorAll<HTMLElement>("[data-panel]")) {
    const id = el.dataset.panel as PanelId;
    if (id === from) continue;
    const b = el.getBoundingClientRect();

    // panel musi leżeć w danym kierunku i nachodzić na nas w osi prostopadłej
    const overlapY = Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top);
    const overlapX = Math.min(a.right, b.right) - Math.max(a.left, b.left);
    let dist: number;
    if (dir === "h" && b.right <= a.left + 1 && overlapY > 0) dist = a.left - b.right;
    else if (dir === "l" && b.left >= a.right - 1 && overlapY > 0) dist = b.left - a.right;
    else if (dir === "k" && b.bottom <= a.top + 1 && overlapX > 0) dist = a.top - b.bottom;
    else if (dir === "j" && b.top >= a.bottom - 1 && overlapX > 0) dist = b.top - a.bottom;
    else continue;

    // remis odległości → wygrywa panel, który był aktywny ostatnio
    const r = recent.indexOf(id);
    const rank = r === -1 ? Infinity : r;
    if (!best || dist < best.dist - 1 || (Math.abs(dist - best.dist) <= 1 && rank < best.rank)) {
      best = { id, dist, rank };
    }
  }
  if (best) return best.id;

  // Zawijanie: w tym kierunku nic nie ma → przeskocz na przeciwną krawędź,
  // do najdalszego panelu, który nachodzi na nas w osi prostopadłej.
  let wrap: { id: PanelId; dist: number; rank: number } | null = null;
  for (const el of document.querySelectorAll<HTMLElement>("[data-panel]")) {
    const id = el.dataset.panel as PanelId;
    if (id === from) continue;
    const b = el.getBoundingClientRect();
    const overlapY = Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top);
    const overlapX = Math.min(a.right, b.right) - Math.max(a.left, b.left);
    let dist: number;
    if (dir === "l" && b.right <= a.left + 1 && overlapY > 0) dist = a.left - b.left;
    else if (dir === "h" && b.left >= a.right - 1 && overlapY > 0) dist = b.right - a.right;
    else if (dir === "j" && b.bottom <= a.top + 1 && overlapX > 0) dist = a.top - b.top;
    else if (dir === "k" && b.top >= a.bottom - 1 && overlapX > 0) dist = b.bottom - a.bottom;
    else continue;
    const r = recent.indexOf(id);
    const rank = r === -1 ? Infinity : r;
    if (!wrap || dist > wrap.dist + 1 || (Math.abs(dist - wrap.dist) <= 1 && rank < wrap.rank)) {
      wrap = { id, dist, rank };
    }
  }
  return wrap?.id ?? null;
}

const MODE: Record<PanelKind, string> = {
    tree: "NORMAL", files: "NORMAL", terminal: "TERMINAL", side: "PROCESY", docker: "DOCKER",
  };

export default function App() {
  const [nav, dispatch] = useReducer(navReducer, { back: [], cwd: null, forward: [] });
  const cwd = nav.cwd;
  const [files, setFiles] = useState<FileEntry[]>([]);
  const [error, setError] = useState<string | null>(null);
  const [selected, setSelected] = useState(0);
  const [active, setActive] = useState<PanelId>("files");
  const [layout, setLayout] = useState<Rect[]>(loadLayout);
  useEffect(() => saveLayout(layout), [layout]);
  const activeKind: PanelKind = layout.find((r) => r.id === active)?.kind ?? "files";
  // aktywny panel zamknięty → fokus na pierwszy otwarty
  useEffect(() => {
    if (layout.length && !layout.some((r) => r.id === active)) setActive(layout[0].id);
  }, [layout, active]);
  const openDir = useCallback((path: string) => dispatch({ type: "go", path }), []);

  // 1) start: folder domowy
  useEffect(() => {
    homeDir().then((p) => dispatch({ type: "init", path: p }));
  }, []);

  // 2) wczytywanie plików przy zmianie cwd
  useEffect(() => {
    if (!cwd) return;
    readDir(cwd)
      .then((f) => { setFiles(f); setError(null); setSelected(0); })
      .catch((e) => setError(String(e)));
  }, [cwd]);

  // historia fokusu: [aktywny, poprzedni, ...], do rozstrzygania remisów
  const recent = useRef<PanelId[]>(["files"]);
  useEffect(() => {
    recent.current = [active, ...recent.current.filter((p) => p !== active)];
  }, [active]);

  // 3) skróty globalne: zawsze aktywne
  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if (e.ctrlKey && !e.altKey && e.code === "KeyQ") {
        e.preventDefault();
        getCurrentWindow().close();
        return;
      }
      // e.code = fizyczny klawisz: działa z CapsLockiem i Shiftem.
      // !ctrlKey: AltGr (Ctrl+Alt) zostaje do pisania polskich znaków.
      const dir = DIR_BY_CODE[e.code];
      if (e.altKey && !e.ctrlKey && dir) {
        e.preventDefault();
        e.stopPropagation();
        const next = findNeighbor(active, dir, recent.current);
        if (next) setActive(next);
      }
    };
    window.addEventListener("keydown", onKey, true);
    return () => window.removeEventListener("keydown", onKey, true);
  }, [active]);

  // 4) klawisze panelu plików: tylko gdy aktywny
  useEffect(() => {
    if (active !== "files") return;

    const onKey = (e: KeyboardEvent) => {
      if (e.altKey || e.ctrlKey) return;

      if (e.key === "j" || e.key === "ArrowDown") {
        e.preventDefault();
        setSelected((i) => Math.min(i + 1, files.length - 1));
      } else if (e.key === "k" || e.key === "ArrowUp") {
        e.preventDefault();
        setSelected((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter" || e.key === "l") {
        e.preventDefault();
        const f = files[selected];
        if (f?.isDir) dispatch({ type: "go", path: f.path });
      } else if ((e.key === "Backspace" || e.key === "h") && cwd) {
        e.preventDefault();
        parentDir(cwd).then((p) => { if (p) dispatch({ type: "go", path: p }); });
      } else if (e.key === "H") {
        e.preventDefault();
        dispatch({ type: "back" });
      } else if (e.key === "L") {
        e.preventDefault();
        dispatch({ type: "forward" });
      }
    };

    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [active, files, selected, cwd]);

  return (
    <div className="shell">
      <Workspace
        layout={layout}
        onLayout={setLayout}
        active={active}
        onActivate={setActive}
        render={(r: Rect) => {
          const panels: Record<PanelKind, () => { title: string; body: ReactNode }> = {
          tree: () => ({
            title: "drzewo",
            body: <TreePanel cwd={cwd} files={files} active={active === "tree"} onOpen={openDir} />,
          }),
          files: () => ({
            title: cwd ?? "...",
            body: (
              <>
                <div className="row head">
                  <span className="c-name">NAME</span><span className="c-type">TYPE</span><span className="c-size">SIZE</span>
                </div>
                {error && <div className="row red">{error}</div>}
                {files.map((f, i) => (
                  <div
                    key={f.path}
                    className={`row ${i === selected && active === "files" ? "sel" : ""}`}
                    onClick={() => setSelected(i)}
                    onDoubleClick={() => f.isDir && dispatch({ type: "go", path: f.path })}
                  >
                    <span className={`c-name ellipsis ${f.isDir ? "accent" : ""}`}>{f.isDir ? f.name + "\\" : f.name}</span>
                    <span className="c-type">{f.isDir ? "dir" : f.name.split(".").pop()}</span>
                    <span className="c-size">{f.isDir ? "—" : formatSize(f.size)}</span>
                  </div>
                ))}
              </>
            ),
          }),
          terminal: () => ({
            title: r.id === "terminal" ? "terminal" : r.id.replace("-", " "),
            body: <TerminalPanel sessionId={r.id} active={active === r.id} />,
          }),
          side: () => ({ title: "procesy", body: <ProcessesPanel active={active === "side"} /> }),
          docker: () => ({ title: "docker", body: <DockerPanel active={active === "docker"} /> }),
          };
          return panels[r.kind]();
        }}
      />

      <footer className="status">
        <span className="mode">{MODE[activeKind]}</span>
        <span>WikExp › src</span>
        <span className="spacer" />
        <span>{activeKind === "side" ? "s sort · xx kill · " : activeKind === "docker" ? "s start/stop · r restart · xx rm · " : ""}przeciągnij tytuł · shift+krawędź = przerwa · ctrl+q quit · alt+hjkl panel</span>
      </footer>
    </div>
  );
}